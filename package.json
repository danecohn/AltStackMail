{
  "name": "altstack-mail",
  "productName": "AltStack Mail",
  "version": "1.0.4",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "AltStack Mail and Calendar, based on the Tuta browser client",
  "author": "Artemis Softworks LLC",
  "main": "desktop/main.mjs",
  "scripts": {
    "desktop": "electron .",
    "package": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "org.altstack.mail",
    "productName": "AltStack Mail",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "assets/**",
      "upstream.json",
      "LICENSE.txt",
      "THIRD-PARTY.md"
    ],
    "artifactName": "AltStackMail-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/logo.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/logo.png",
      "category": "Office",
      "maintainer": "Artemis Softworks LLC"
    },
    "afterPack": "scripts/adhoc-sign.cjs",
    "copyright": "Copyright \u00a9 2026 Artemis Softworks LLC"
  }
}
